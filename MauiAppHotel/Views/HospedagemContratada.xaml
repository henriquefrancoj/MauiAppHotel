<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="LightBlue">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
         <Label x:Name="lbl_suite"
               FontFamily="Roboto"
               FontSize="35"
               TextColor="MidnightBlue"
               HorizontalTextAlignment="Center"/>
        <Border Margin="10" Padding="20" HorizontalOptions="Center"
                BackgroundColor="MidnightBlue">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos: " />
                    <Label x:Name="lbl_adultos" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Crianças: " />
                    <Label x:Name="lbl_criancas" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <Border Margin="10" Padding="20" 
                BackgroundColor="MidnightBlue">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Check-in"/>
                <Label Grid.Row="0" Grid.Column="1"
                       Text="Check-out"/>
                <Label Grid.Row="0" Grid.Column="2"
                       Text="Estadia"/>

                <Label x:Name="lbl_checkin"
                       Grid.Row="1" Grid.Column="0"/>
                <Label x:Name="lbl_checkout"
                       Grid.Row="1" Grid.Column="1"/>
                <Label x:Name="lbl_estadia"
                       Grid.Row="1" Grid.Column="2"/>
            </Grid>
        </Border>
        
        <Border Margin="10" Padding="20"
                BackgroundColor="MidnightBlue">
            <HorizontalStackLayout>
                <Label Text="Valor total: "/>
                <Label x:Name="lbl_valor_total" />
            </HorizontalStackLayout>    
        </Border>

        <HorizontalStackLayout HorizontalOptions="Center">
            <Button Text="Confirmar reserva" Margin="7" BackgroundColor="CadetBlue"
                    Clicked="ConfReserva_Click" />
            <Button Text="Voltar" Margin="7" BackgroundColor="CadetBlue"
                Clicked="Voltar_Inicio_Click" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>